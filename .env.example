# Copy to .env and add your keys. Keep .env local, it is gitignored.

# LLM used for synthesis
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Web search
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=
# DuckDuckGo needs no key, just install duckduckgo-search.

# Our settings
LOG_LEVEL=INFO
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
PER_SOURCE_TIMEOUT_SECONDS=10
MAX_SOURCES_PER_QUERY=3
MAX_PARALLEL=5
RETRY_ATTEMPTS=3
RETRY_MIN_WAIT=1
RETRY_MAX_WAIT=8
DATABASE_URL=sqlite:///./researcher.db
